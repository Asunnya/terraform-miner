# Copy to .env (same folder) and fill in. .env is gitignored: never commit real keys.
# src/llm_analysis reads these; variables already set in the shell take precedence.

# llm.provider: anthropic (default)
ANTHROPIC_API_KEY=

# llm.provider: openai (not needed for local OpenAI-compatible servers with base_url)
OPENAI_API_KEY=

# llm.provider: litellm reads each vendor's standard variable, e.g.:
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
